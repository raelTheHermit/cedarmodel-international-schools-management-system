+.ap-selected-note { margin: 17px 0 0; font-size: 9px; color: var(--pt-muted); }
+.ap-facts { margin: 24px 0 0; text-align: left; }
+.ap-facts div { min-height: 37px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--pt-line-soft); }
+.ap-facts dt { font-size: 8.5px; color: var(--pt-muted); }
+.ap-facts dd { margin: 0; font-size: 8.5px; font-weight: 700; }
+.ap-callout-warning { margin: 14px 0 0; padding: 12px 12px; border: 1px solid var(--pt-red-line); border-radius: 6px; background: var(--pt-red-bg); font-size: 8.5px; color: #8a4636; text-align: left; }
+.ap-selected-empty { min-height: 168px; margin-top: 52px; display: grid; gap: 14px; align-content: start; }
+.ap-selected-empty strong { font-size: 10px; }
+.ap-selected-empty p { margin: 0; font-size: 8.5px; color: var(--pt-muted); }
+.ap-selected-actions { margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
+.ap-selected-actions .ap-button { height: 46px; padding: 0 14px; font-size: 12px; }
+.ap-selected-actions .ap-button.light { font-weight: 700; }
+.selected-card .ap-kicker { margin-top: 0; }
+
+/* ==========================================================================
+   Responsive
+   ========================================================================== */
+
+@media (max-width: 1100px) {
+  .au-shell { grid-template-columns: 1fr; }
+  .au-hero { display: none; }
+  .pp-grid { grid-template-columns: 1fr; }
+  .ap-stat-grid.four { grid-template-columns: repeat(2, 1fr); }
+  .ap-overview-grid,
+  .ap-split { grid-template-columns: 1fr; }
+  .ap-quick-grid { grid-template-columns: repeat(2, 1fr); }
+  .pp-greeting { font-size: 38px; }
+}
+
+@media (max-width: 820px) {
+  .pp-shell,
+  .ap-shell { grid-template-columns: 1fr; }
+  .pp-sidebar,
+  .ap-sidebar { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px 14px; border-right: 0; border-bottom: 1px solid var(--pt-line); }
+  .pp-nav,
+  .ap-nav { margin: 0; display: flex; flex-wrap: wrap; }
+  .ap-nav-label,
+  .ap-sidebar-foot .ap-user { display: none; }
+  .pp-logout,
+  .ap-logout { margin: 0 0 0 auto; }
+  .ap-sidebar-foot { margin: 0; padding: 0; border: 0; }
+  .pp-content,
+  .ap-content { padding: 0 18px 40px; }
+  .pp-topbar,
+  .ap-topbar { padding: 0 18px; }
+  .ap-search { display: none; }
+  .ap-title { font-size: 38px; }
+  .ap-page-header { flex-direction: column; align-items: flex-start; }
+  .ap-panel-head { flex-direction: column; align-items: stretch; }
+  .ap-panel-controls { flex-wrap: wrap; }
+  .ap-inline-search { width: 100%; }
+  .ap-table { overflow-x: auto; }
+  .ap-table-head,
+  .ap-table-row { min-width: 760px; }
+  .ap-record { min-width: 720px; }
+  .ap-records { overflow-x: auto; }
+  .ap-form-grid,
+  .ap-metric-pair { grid-template-columns: 1fr; }
+  .pp-meta,
+  .pp-summary,
+  .pp-details { grid-template-columns: 1fr; }
+  .pp-average { border-right: 0; }
+  .pp-detail { border-right: 0; border-bottom: 1px solid var(--pt-line-soft); }
+  .pp-card-body.cta { flex-direction: column; align-items: flex-start; }
+  .pp-banner { flex-wrap: wrap; padding: 20px; }
+  .pp-state-title { font-size: 28px; }
+  .au-title.large { font-size: 36px; }
+  .au-shell { padding: 0; gap: 0; }
+  .au-panel { border-radius: 0; }
+}
